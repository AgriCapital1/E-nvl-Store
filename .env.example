# ---------------------------------------------------------------
# E'nvlé Store — variables d'environnement (exemple, aucune valeur réelle)
# Copier en .env pour le développement local. Ne jamais committer .env.
# ---------------------------------------------------------------

# --- Client (exposé au navigateur, clés publiques uniquement) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<clé publiable / anon>
VITE_SUPABASE_PROJECT_ID=<project-ref>

# --- Serveur (jamais exposé au navigateur) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<clé publiable / anon>
SUPABASE_PROJECT_ID=<project-ref>

# Secrets serveur : à définir dans le gestionnaire de secrets de l'hébergeur,
# jamais dans un fichier committé.
# SUPABASE_SERVICE_ROLE_KEY=<clé service role — secret>
# ENVLE_BUILD_CALLBACK_SECRET=<secret partagé du worker de build>
